{
  "appId": "com.deja.tray",
  "productName": "Deja Tray",
  "directories": {
    "output": "dist-electron"
  },
  "files": [
    "dist-tray/**/*",
    "src/tray/icons/**/*"
  ],
  "extraMetadata": {
    "main": "dist-tray/main.js"
  },
  "win": {
    "target": "dir",
    "icon": "src/tray/icons/app-icon.png"
  },
  "mac": {
    "target": [
      { "target": "dmg", "arch": ["x64", "arm64"] }
    ],
    "icon": "src/tray/icons/app-icon.png",
    "category": "public.app-category.utilities"
  }
}
